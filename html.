14px;padding:20px;background:#204936;font:14px/1.9 monospace;transform:rotate(-3deg);box-shadow:10px 12px 0 #102f2540}.code b{color:#e7cc81}.code span{color:#b2dbb6}.primary,.secondary{display:inline-block;border:0;border-radius:9px;padding:11px 18px;font-weight:700}.primary{background:var(--green);color:white}.hero .primary{background:#e8d99f;color:#20392b;margin-top:17px}.secondary{background:#edf2eb;color:var(--ink)}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin:22px 0}.card{background:#fff;border:1px solid var(--line);border-radius:16px;padding:24px}.stat{font-size:29px;font-weight:800;letter-spacing:-1px}.label{font-size:13px;color:var(--muted)}.grid{display:grid;grid-template-columns:1.4fr 1fr;gap:22px}.row{display:flex;justify-content:space-between;gap:15px;align-items:center}.pill{font-size:11px;background:#f0f3e8;color:#657842;padding:4px 9px;border-radius:30px;white-space:nowrap}.task{display:flex;align-items:start;gap:12px;padding:16px 0;border-top:1px solid var(--line)}input[type=checkbox]{accent-color:var(--green);width:19px;height:19px;margin-top:4px;flex-shrink:0}.task small{color:var(--muted);display:block}.bar{height:7px;background:#e9eee6;border-radius:8px;overflow:hidden;margin-top:16px}.bar div{background:var(--green);height:100%;transition:width .3s}.section-title{margin-bottom:23px}.section-title p{max-width:650px}.days{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.day{cursor:pointer;text-align:left;color:var(--ink)}.day.done{background:#edf6ef;border-color:#9bc9a6}.day.selected{border:2px solid var(--green);padding:23px}.day .eyebrow{color:var(--green)}.lesson{margin-top:24px}.lesson pre{white-space:pre-wrap;background:#173e30;color:#d5ebd9;padding:20px;border-radius:12px;overflow:auto}textarea,input:not([type=checkbox]),select{width:100%;border:1px solid #d5ded4;border-radius:8px;background:#fff;padding:10px;color:var(--ink)}textarea{min-height:110px;resize:vertical}.field{display:grid;gap:5px;margin:13px 0}label{font-size:13px;font-weight:650}.answer{background:#edf5ee;border-radius:10px;padding:18px;margin-top:15px}.projects{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.project-icon{font-size:26px;background:#f0f2e5;border-radius:12px;width:54px;height:54px;display:grid;place-items:center;margin-bottom:18px}.job{border-top:1px solid var(--line);padding:18px 0}.job select{max-width:160px}.empty{padding:35px;text-align:center;color:var(--muted);background:#f7f8f4;border-radius:10px}a{color:var(--green)}.page{display:none}.page.active{display:block}.toast{position:fixed;bottom:22px;left:50%;transform:translateX(-50%);background:#173e30;color:#fff;padding:12px 22px;border-radius:9px;z-index:10;display:none}.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}.subtle{font-size:12px;color:var(--muted)}.danger{border:0;background:none;color:#9f3e35;padding:7px}.number{display:inline-block;color:var(--green);font-weight:800;margin-right:7px}@media(max-width:1000px){main{padding:25px}.days,.projects{grid-template-columns:repeat(2,1fr)}.grid{grid-template-columns:1fr}}@media(max-width:700px){aside{position:static;width:auto;padding:18px}nav{display:flex;overflow:auto;margin-top:15px;gap:4px}nav button{white-space:nowrap;padding:10px}aside footer{display:none}main{margin:0;padding:20px}.top{margin-bottom:22px}.hero{grid-template-columns:1fr;padding:25px}.code{display:none}.stats{gap:8px}.stats .card{padding:15px 10px}.stat{font-size:24px}.days,.projects{grid-template-columns:1fr}.badge{font-size:10px}.row{flex-wrap:wrap}}@media(prefers-reduced-motion:reduce){*{transition:none!important}}
