const steps=[
['HTML','Your first page','HTML gives your page structure, like the rooms in a house.','Make a page with your name, a heading, and one paragraph.','<h1>Hello, I’m a frontend learner!</h1>\n<p>This is my first page.</p>'],
['HTML','Links and images','A link is a door to another page. An image needs alt text so its meaning can be understood without seeing it.','Add a link and an image with useful alt text.','<a href="https://example.com">Visit my project</a>\n<img src="photo.jpg" alt="My workspace">'],
['HTML','Lists and sections','Lists organize related things. Sections group related content.','Add a list of three skills and an About section.','<section>\n  <h2>My skills</h2>\n  <ul><li>HTML</li><li>CSS</li></ul>\n</section>'],
['HTML','Build a simple form','Labels tell people what to enter. Inputs collect their answers.','Make a name and email form with visible labels.','<label for="email">Email</label>\n<input id="email" type="email" required>'],
['CSS','Colors and fonts','CSS is your page’s outfit. It changes how things look.','Choose a background, readable text color, and font.','body { background: #f6f7f2; color: #172823;\n  font-family: Arial, sans-serif; }'],
['CSS','Spacing and boxes','Padding is space inside a box. Margin is space outside it.','Make a card with padding, margin, and a border.','.card { padding: 24px; margin: 16px;\n  border: 1px solid #ddd; border-radius: 12px; }'],
['CSS','Flexbox','Flexbox helps arrange items in a row or column.','Place a logo and menu on opposite sides of a header.','header { display: flex; justify-content: space-between;\n  align-items: center; }'],
['CSS','Grid','Grid arranges items into rows and columns, like a shelf.','Create a grid of three project cards.','.projects { display: grid;\n  grid-template-columns: repeat(3, 1fr); gap: 16px; }'],
['CSS','Make it mobile friendly','Responsive pages fit small phones and big screens.','Make your three-column grid turn into one column on a phone.','@media (max-width: 600px) {\n  .projects { grid-template-columns: 1fr; }\n}'],
['JavaScript','Variables','A variable is a named box that holds a value.','Store your name and print a greeting in the console.','const name = "Apsar";\nconsole.log("Hello, " + name);'],
['JavaScript','Functions','A function is a reusable set of instructions.','Write a function that adds two numbers.','function add(a, b) { return a + b; }\nconsole.log(add(3, 4));'],
['JavaScript','Click events','An event tells your code something happened.','Make a button change text when clicked.','button.addEventListener("click", () => {\n  heading.textContent = "You did it!";\n});'],
['JavaScript','Arrays and objects','An array is a list. An object groups details about one thing.','Create a list of tasks, each with a title and done value.','const tasks = [\n  { title: "Practice CSS", done: false }\n];'],
['JavaScript','Build a task list','Combine inputs, events, and arrays to make something useful.','Let a user add and complete tasks. Use textContent for their text.','const item = document.createElement("li");\nitem.textContent = input.value;\nlist.append(item);'],
['JavaScript','Save your progress','localStorage remembers small amounts of data in the same browser.','Save your tasks, refresh, and load them again.','localStorage.setItem("tasks", JSON.stringify(tasks));\nconst saved = JSON.parse(localStorage.getItem("tasks") || "[]");'],
['Quality','Accessibility','Everyone should be able to use your page, including with a keyboard.','Use Tab to visit each control. Check labels and visible focus styles.','button:focus-visible {\n  outline: 3px solid #237c57; outline-offset: 3px;\n}'],
['Quality','Find and fix bugs','Developer tools are your detective kit.','Open browser developer tools, check the Console, and fix one error.','console.log("Value before update:", tasks);'],
['Git','Keep a code history','Git stores snapshots so you can see what changed.','Initialize a practice folder and commit your files.','git init\ngit add .\ngit commit -m "Build my first page"'],
['Portfolio','Your portfolio page','A portfolio shows your work and explains what you did.','Build an About section and three project cards.','Each project: problem → what I built → what I learned.'],
['Portfolio','Test your projects','A working project is easier to explain confidently.','Test on a phone-sized screen, with keyboard navigation, and after refresh.','Checklist: input works, buttons work, no overflow, data saves.'],
['Career','Explain your work','Interviewers need to understand your choices and learning.','Give a 60-second explanation of your best project and add one job to the tracker.','I built…\nIt helps people…\nOne challenge was…\nI solved it by…']];
const qs=[['What do HTML, CSS, and JavaScript do?','Think: structure, appearance, behavior.','HTML creates the structure, CSS styles it, and JavaScript adds behavior. In a task app, HTML creates a button, CSS makes it look nice, and JavaScript adds a task when you click it.'],['What is the difference between margin and padding?','Imagine a box with space inside and outside.','Padding is space between content and its border. Margin is space outside the border, separating the element from nearby elements.'],['How do you make a page responsive?','How does your layout change on a phone?','I use flexible widths, Flexbox or Grid, and media queries. I test small and large screens and check that text, images, and buttons remain usable.'],['What is an event listener?','What happens when someone clicks?','An event listener runs a function when something happens, such as a click or a key press. I can listen for a button click and update the page.'],['What is localStorage?','Where does this app keep your progress?','localStorage saves small amounts of string data in the browser for a website. I use JSON to save objects. It stays after refresh, but it does not sync across devices and can be cleared.'],['How do you make a website accessible?','Think about keyboards and screen readers.','I use meaningful HTML, visible input labels, alt text for meaningful images, readable contrast, and visible keyboard focus. I test that all controls work without a mouse.'],['Describe a project you built.','Explain the problem, your work, and a challenge.','I built a task tracker to organize daily work. I used HTML, CSS, and JavaScript. Saving data after refresh was a challenge, so I used localStorage and tested adding, completing, and reloading tasks. Replace this example with your own experience.'],['What is the difference between let and const?','Can the variable be assigned a new value?','let allows reassignment. const does not allow reassignment of the variable. An object or array stored in a const variable can still have its contents changed.']];
const projectDefs=[['01','Personal portfolio','Introduce yourself and show your best work.',['About section and contact link','Three clear project cards','Works on phone and keyboard']],['02','Task manager','Help people remember and finish their tasks.',['Add, complete, and delete tasks','Save tasks after refresh','Empty state and readable layout']],['03','Expense tracker','Help people see where their money goes.',['Add and remove expenses','Show a correct total','Save entries and validate amounts']]];
const initial=()=>({done:[],daily:{},projects:{},jobs:[],answers:{},selected:0,q:0});let state;try{state={...initial(),...JSON.parse(localStorage.getItem('jobready-v1')||'{}')}}catch{state=initial()}
const $=id=>document.getElementById(id);let toastTimer;function toast(msg){$('toast').textContent=msg;$('toast').style.display='block';clearTimeout(toastTimer);toastTimer=setTimeout(()=>$('toast').style.display='none',2500)}function save(){try{localStorage.setItem('jobready-v1',JSON.stringify(state))}catch{toast('Could not save in this browser. Download a backup.')}stats()}function escapeHTML(v){return String(v).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}function safeURL(v){try{const u=new URL(v);return ['http:','https:'].includes(u.protocol)?u.href:''}catch{return ''}}function page(id){document.querySelectorAll('.page').forEach(x=>x.classList.toggle('active',x.id===id));document.querySelectorAll('nav button').forEach(x=>x.classList.toggle('active',x.dataset.page===id));window.scrollTo(0,0)}document.querySelectorAll('nav button').forEach(b=>b.onclick=()=>page(b.dataset.page));
function stats(){$('learnStat').textContent=state.done.length+' / 21';$('progressBar').style.width=state.done.length/21*100+'%';$('projectStat').textContent=projectDefs.filter((_,i)=>[0,1,2].every(j=>state.projects[i]?.checks?.includes(j))).length+' / 3';$('jobStat').textContent=state.jobs.length}
function daily(){const today=new Date().toLocaleDateString('en-CA');$('daily').innerHTML=['Learn one small concept','Try it in your own code editor','Explain what you learned aloud'].map((t,i)=>`<label class="task"><input type="checkbox" data-daily="${i}" ${state.daily[today]?.includes(i)?'checked':''}><span>${t}<small>${['10 minutes • Read a learning step','15 minutes • Build and test','5 minutes • Practice for interviews'][i]}</small></span></label>`).join('');document.querySelectorAll('[data-daily]').forEach(c=>c.onchange=()=>{let a=state.daily[today]||[];let i=+c.dataset.daily;state.daily[today]=c.checked?[...a,i]:a.filter(x=>x!==i);save()})}
function learning(){$('days').innerHTML=steps.map((s,i)=>`<button class="card day ${state.done.includes(i)?'done':''} ${state.selected===i?'selected':''}" data-day="${i}"><div class="row"><span class="eyebrow">Step ${String(i+1).padStart(2,'0')} · ${s[0]}</span><span>${state.done.includes(i)?'✓':'↗'}</span></div><h3 style="margin-top:12px">${s[1]}</h3><span class="subtle">${i<4?'Structure':i<9?'Style':i<15?'Behavior':'Put it together'}</span></button>`).join('');document.querySelectorAll('[data-day]').forEach(b=>b.onclick=()=>{state.selected=+b.dataset.day;save();learning();$('lesson').scrollIntoView({behavior:'smooth',block:'start'})});const i=state.selected,s=steps[i];$('lesson').innerHTML=`<span class="pill">STEP ${i+1} · ${s[0]}</span><h2 style="margin-top:15px">${s[1]}</h2><p>${s[2]}</p><h3 style="margin-top:20px">Your small task</h3><p>${s[3]}</p><pre><code>${escapeHTML(s[4])}</code></pre><div class="actions"><button class="primary" id="complete">${state.done.includes(i)?'✓ Completed · undo':'Mark step complete ✓'}</button><button class="secondary" id="nextStep" ${i===20?'disabled':''}>Next step →</button></div>`;$('complete').onclick=()=>{state.done=state.done.includes(i)?state.done.filter(x=>x!==i):[...state.done,i];save();learning();toast('Progress updated')};$('nextStep').onclick=()=>{state.selected=Math.min(20,i+1);save();learning()}}
function projects(){$('projectCards').innerHTML=projectDefs.map((p,i)=>`<article class="card"><div class="project-icon">${p[0]}</div><h2>${p[1]}</h2><p>${p[2]}</p>${p[3].map((t,j)=>`<label class="task"><input type="checkbox" data-project="${i}" data-check="${j}" ${state.projects[i]?.checks?.includes(j)?'checked':''}><span>${t}</span></label>`).join('')}<label class="field">Working project link<input type="url" data-link="${i}" value="${escapeHTML(state.projects[i]?.url||'')}" placeholder="https://…"></label><button class="secondary" data-open="${i}">Open my project ↗</button></article>`).join('');document.querySelectorAll('[data-project]').forEach(c=>c.onchange=()=>{const i=+c.dataset.project,j=+c.dataset.check;state.projects[i]??={checks:[],url:''};let a=state.projects[i].checks;state.projects[i].checks=c.checked?[...a,j]:a.filter(x=>x!==j);save()});document.querySelectorAll('[data-link]').forEach(c=>c.onchange=()=>{const i=+c.dataset.link,u=safeURL(c.value);if(c.value&&!u){toast('Enter a full http or https link');return}state.projects[i]??={checks:[],url:''};state.projects[i].url=u;save()});document.querySelectorAll('[data-open]').forEach(b=>b.onclick=()=>{const u=safeURL(state.projects[b.dataset.open]?.url||'');if(u)window.open(u,'_blank','noopener,noreferrer');else toast('Save your project link first')})}
function question(){const q=qs[state.q];$('questionCount').textContent='QUESTION '+(state.q+1)+' / '+qs.length;$('question').textContent=q[0];$('hint').textContent=q[1];$('practice').value=state.answers[state.q]||'';$('answer').textContent=q[2];$('answer').hidden=true;$('reveal').textContent='Show example answer'}$('practice').oninput=()=>{state.answers[state.q]=$('practice').value;save()};$('reveal').onclick=()=>{$('answer').hidden=!$('answer').hidden;$('reveal').textContent=$('answer').hidden?'Show example answer':'Hide example answer'};$('nextQ').onclick=()=>{state.q=(state.q+1)%qs.length;save();question()};
function jobs(){$('jobCount').textContent=state.jobs.length+' saved';$('jobList').innerHTML=state.jobs.length?state.jobs.map((j,i)=>`<article class="job"><h3>${escapeHTML(j.company)}</h3><p>${escapeHTML(j.role)}</p>${j.url?`<a href="${escapeHTML(safeURL(j.url))}" target="_blank" rel="noopener noreferrer">View job ↗</a>`:''}<label class="field">Application status<select data-status="${i}">${['Saved','Applied','Interview','Offer','Closed'].map(s=>`<option ${j.status===s?'selected':''}>${s}</option>`).join('')}</select></label><label class="field">Next step<input data-next="${i}" maxlength="200" value="${escapeHTML(j.next||'')}"></label><div class="row"><span class="subtle">Added ${escapeHTML(j.date)}</span><button class="danger" data-remove="${i}">Remove</button></div></article>`).join(''):'<div class="empty">No opportunities yet.<br>Add your first job on the left.</div>';document.querySelectorAll('[data-status]').forEach(c=>c.onchange=()=>{state.jobs[c.dataset.status].status=c.value;save()});document.querySelectorAll('[data-next]').forEach(c=>c.onchange=()=>{state.jobs[c.dataset.next].next=c.value;save()});document.querySelectorAll('[data-remove]').forEach(b=>b.onclick=()=>{state.jobs.splice(+b.dataset.remove,1);save();jobs();toast('Opportunity removed')})}
$('jobForm').onsubmit=e=>{e.preventDefault();const f=new FormData(e.target);const company=f.get('company').trim(),role=f.get('role').trim();if(!company||!role)return;const u=f.get('url');if(u&&!safeURL(u)){toast('Use an http or https job link');return}state.jobs.unshift({company,role,url:safeURL(u),next:f.get('next').trim(),status:'Saved',date:new Date().toLocaleDateString()});save();jobs();e.target.reset();toast('Opportunity saved')};$('continue').onclick=()=>{state.selected=steps.findIndex((_,i)=>!state.done.includes(i));if(state.selected<0)state.selected=20;save();learning();page('learn')};$('export').onclick=()=>{const blob=new Blob([JSON.stringify(state,null,2)],{type:'application/json'}),u=URL.createObjectURL(blob),a=document.createElement('a');a.href=u;a.download='jobready-progress.json';a.click();setTimeout(()=>URL.revokeObjectURL(u),1000);toast('Backup downloaded')};$('import').onchange=async e=>{try{const f=e.target.files[0];if(!f)return;if(f.size>1000000)throw Error();const s=JSON.parse(await f.text());if(!Array.isArray(s.done)||!Array.isArray(s.jobs)||!s.projects||!s.answers||!s.daily||s.jobs.some(j=>!j||typeof j.company!=='string'||typeof j.role!=='string')||s.done.some(n=>!Number.isInteger(n)||n<0||n>20))throw Error();if(!confirm('Replace current progress with this backup?'))return;state={...initial(),...s,done:[...new Set(s.done)],selected:Number.isInteger(s.selected)&&s.selected>=0&&s.selected<21?s.selected:0,q:Number.isInteger(s.q)&&s.q>=0&&s.q<qs.length?s.q:0};save();render();toast('Backup restored')}catch{toast('This backup could not be restored. Choose a JobReady backup.')}e.target.value=''};function render(){stats();daily();learning();projects();question();jobs()}render();

